{
 "date": "2026-10-22",
 "question": "Is afdEP's Masked arm (vendored DeepEP V2 with role_aware=False) the same as Masked DeepEP as deployed by afd-plugin?",
 "reference": "afd-plugin deepep_m2n DeepEPElasticBuffer (ms-llmd/afd-plugin fastafd-connector line, local checkout at 7cc7ebd): FastAFD 3c71619 DeepEP V2 snapshot plus the plugin's patches, specialize_roles off; copied into a scratch package 'pm' with only its import paths rewritten",
 "afdep_native_source_sha256": "958652a3538af7478544b8259a6f108b1838e1e14d77ea95e0940f8805218663",
 "setup": "4 x H200 (kermit), BF16, hidden 2048, top-k 8 of 128 experts, capacity 2048, CUDA graphs, num_sms default (24), hybrid allowed (one NVLink domain), random routes with the same seeds; 3 interleaved fresh-process repeats per arm",
 "driver": "\"\"\"Time afd-plugin's Masked DeepEP (deepep_m2n: FastAFD 3c71619 DeepEP V2 + plugin patches, specialize_roles off)\nexactly as afdEP's benchmarks/comm.py times its arms: same routes and seeds, bucket = tokens, warmup, iterations and\nblocks, CUDA graph replay, metric = per block max over Attention ranks of CUDA-event us per exchange.\nRun with torchrun; PYTHONPATH must contain the scratch package root holding `pm` (buffer.py, jit_build.py, layout.py, csrc/).\"\"\"\n\nimport argparse\nimport json\nimport os\nimport statistics\n\nimport torch\nimport torch.distributed as dist\n\nfrom pm.buffer import DeepEPElasticBuffer\nfrom pm.layout import DeepEPM2NLayout\n\n\ndef routes(args, rank, n):\n    \"\"\"Identical to afdEP benchmarks/comm.py routes() for --routing random.\"\"\"\n    source = max(rank - args.ffn_ranks, 0)\n    generator = torch.Generator(device=\"cuda\").manual_seed(args.routing_seed + source)\n    return torch.rand((n, args.experts), generator=generator, device=\"cuda\").topk(args.top_k, dim=1).indices\n\n\ndef timed(exchange, iterations):\n    start, end = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)\n    start.record()\n    for _ in range(iterations):\n        exchange()\n    end.record()\n    end.synchronize()\n    return start.elapsed_time(end) * 1000 / iterations\n\n\ndef main():\n    p = argparse.ArgumentParser()\n    p.add_argument(\"--ffn-ranks\", type=int, default=2)\n    p.add_argument(\"--attention-ranks\", type=int, default=2)\n    p.add_argument(\"--hidden\", type=int, default=2048)\n    p.add_argument(\"--experts\", type=int, default=128)\n    p.add_argument(\"--top-k\", type=int, default=8)\n    p.add_argument(\"--capacity\", type=int, default=2048)\n    p.add_argument(\"--tokens\", type=int, nargs=\"+\", default=[1, 8, 32, 128, 512, 2048])\n    p.add_argument(\"--hybrid\", choices=[\"on\", \"off\"], default=\"on\")\n    p.add_argument(\"--num-sms\", type=int, default=0)\n    p.add_argument(\"--routing-seed\", type=int, default=49001)\n    p.add_argument(\"--warmup\", type=int, default=200)\n    p.add_argument(\"--iterations\", type=int, default=200)\n    p.add_argument(\"--blocks\", type=int, default=10)\n    p.add_argument(\"--output\", required=True)\n    args = p.parse_args()\n    rank = int(os.environ[\"RANK\"])\n    torch.cuda.set_device(int(os.environ[\"LOCAL_RANK\"]))\n    dist.init_process_group(\"gloo\")\n    world = dist.get_world_size()\n    assert world == args.ffn_ranks + args.attention_ranks\n    layout = DeepEPM2NLayout(ffn_size=args.ffn_ranks, attn_size=args.attention_ranks, num_experts=args.experts)\n    buf = DeepEPElasticBuffer(\n        group=dist.group.WORLD, capacity_tokens_per_rank=args.capacity, hidden_size=args.hidden,\n        num_experts=layout.deepep_num_experts, top_k=args.top_k, allow_hybrid_mode=args.hybrid == \"on\",\n        rdma_traffic_class=0, cpu_timeout_s=120, gpu_timeout_s=120, use_fp8_dispatch=False, num_sms=args.num_sms)\n    ffn = rank < args.ffn_ranks\n    cells = []\n    for n in args.tokens:\n        if ffn:\n            x = torch.empty((0, args.hidden), dtype=torch.bfloat16, device=\"cuda\")\n            ids = torch.empty((0, args.top_k), dtype=torch.long, device=\"cuda\")\n            weights = torch.empty((0, args.top_k), device=\"cuda\")\n        else:\n            x = torch.ones((n, args.hidden), dtype=torch.bfloat16, device=\"cuda\")\n            ids = routes(args, rank, n)\n            weights = torch.full((n, args.top_k), 1 / args.top_k, device=\"cuda\")\n        state = {\"expert\": None, \"result\": None}\n\n        def step():\n            r = buf.dispatch(x, None, ids, weights, bucket=n, expert_alignment=128, do_cpu_sync=False)\n            if state[\"expert\"] is None:\n                # Filled once outside capture/timing: FFN rows contribute one each; Attention contributes zero rows.\n                fill = torch.ones if ffn else torch.zeros\n                state[\"expert\"] = fill(r.handle.recv_shape, dtype=torch.bfloat16, device=\"cuda\")\n            state[\"result\"] = buf.combine(state[\"expert\"], r.handle)\n\n        for _ in range(2):\n            step()\n        torch.cuda.synchronize()\n        dist.barrier()\n        graph = torch.cuda.CUDAGraph()\n        with torch.cuda.graph(graph):\n            step()\n        for _ in range(args.warmup):\n            graph.replay()\n        torch.cuda.synchronize()\n        if not ffn:\n            torch.testing.assert_close(state[\"result\"], torch.full_like(state[\"result\"], args.top_k), rtol=0, atol=0)\n        dist.barrier()\n        blocks = []\n        for _ in range(args.blocks):\n            dist.barrier()\n            us = timed(graph.replay, args.iterations)\n            gathered = [None] * world\n            dist.all_gather_object(gathered, {\"rank\": rank, \"attention\": not ffn, \"us\": us})\n            blocks.append(max(g[\"us\"] for g in gathered if g[\"attention\"]))\n        if not ffn:\n            torch.testing.assert_close(state[\"result\"], torch.full_like(state[\"result\"], args.top_k), rtol=0, atol=0)\n        del graph\n        torch.cuda.synchronize()\n        dist.barrier()\n        cells.append({\"tokens\": n, \"median_us\": statistics.median(blocks), \"blocks_us\": blocks})\n        if rank == 0:\n            print(json.dumps({\"tokens\": n, \"plugin_masked_us\": round(statistics.median(blocks), 2)}), flush=True)\n    if rank == 0:\n        json.dump({\"args\": vars(args), \"cells\": cells,\n                   \"metric\": \"per block: max Attention-rank CUDA-event us per exchange (as benchmarks/comm.py)\"},\n                  open(args.output, \"w\"), indent=1)\n    buf.destroy()\n    dist.destroy_process_group()\n\n\nif __name__ == \"__main__\":\n    main()\n",
 "runner": "#!/usr/bin/env bash\n# pm-compare.sh: plugin Masked DeepEP (FastAFD snapshot) vs afdEP Masked arm vs afdEP role path, same pod, interleaved fresh processes.\nexport AFDEP_NCCL_ROOT=/work/nccl/nvidia/nccl LD_LIBRARY_PATH=/work/nccl/nvidia/nccl/lib LD_PRELOAD=/work/nccl/nvidia/nccl/lib/libnccl.so.2 \\\n  AFDEP_CACHE_DIR=/work/cache/afdep EP_JIT_CACHE_DIR=/work/cache/deepep-jit XDG_CACHE_HOME=/work/cache HOME=/work \\\n  EP_DISABLE_GIN=1 MAX_JOBS=16 OMP_NUM_THREADS=1 PYTHONSAFEPATH=1\nR=/work/results/pm; mkdir -p $R\nA='{\"masked\":{\"role_aware\":false},\"afd\":{}}'\nP=\"--payload bf16 --routing random --hidden 2048 --capacity 2048 --tokens 1 8 32 128 512 2048\"\nfor lay in \"2a2f 2 2\" \"3a1f 1 3\"; do set -- $lay; tag=$1 f=$2 a=$3\n  for r in 0 1 2; do\n    (cd /work/pm-root && PYTHONPATH=/work/pm-root:/work/nccl timeout 1800 torchrun --standalone --nproc-per-node=4 /work/pm_masked.py --ffn-ranks $f --attention-ranks $a --output $R/pm-$tag-r$r.json > $R/pm-$tag-r$r.log 2>&1)\n    (cd /work/src-cf && PYTHONPATH=/work/src-cf python -m benchmarks.screen --repeats 1 --arms \"$A\" --output $R/af-$tag-r$r.json -- $P --ffn-ranks $f --attention-ranks $a > $R/af-$tag-r$r.txt 2>&1)\n  done\ndone\necho done > $R/DONE\n",
